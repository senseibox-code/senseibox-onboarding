#!/bin/sh
set -eu

APP_PYTHON="/opt/senseibox/senseibox-onboarding/.venv/bin/python"
COMPLETE_MARKER="/var/lib/senseibox/onboarding/complete"

case " $* " in
  *" --reset "*)
    ;;
  *)
    if [ -f "$COMPLETE_MARKER" ]; then
      echo "Senseibox setup is already complete."
      echo "Run 'sudo senseibox-setup --reset' to set up again."
      exit 0
    fi
    ;;
esac

if [ "$(id -u)" -ne 0 ]; then
  exec sudo "$APP_PYTHON" -m senseibox_onboarding.app "$@"
fi

exec "$APP_PYTHON" -m senseibox_onboarding.app "$@"
